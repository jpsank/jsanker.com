# Copy to .env (gitignored) and fill in. Read by docker compose (env_file) and
# by `docker run --env-file`.

# Firebase web-client config for the blog (/blog/). These are public identifiers,
# not secrets; access control lives in firestore.rules. Find them in the Firebase
# console under Project settings > Your apps. If unset, the blog shows
# "not configured".
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Host name served by Caddy/FrankenPHP in production (automatic HTTPS).
# Leave unset for plain HTTP on :80 in development.
# SERVER_NAME=jsanker.com

# OpenChat: set to 1 to allow image uploads (default off).
# OPENCHAT_ALLOW_IMAGES=0
